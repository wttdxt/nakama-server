databases:
  - name: nakama-postgres
    plan: free
    databaseName: nakama

services:
  - type: web
    name: nakama
    env: docker
    plan: free
    dockerfilePath: ./Dockerfile
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: nakama-postgres
          property: connectionString
      - key: socket.server_key
        value: defaultkey
